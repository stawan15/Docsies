# Local development template. Copy to .env.local and replace every placeholder.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-your-access-key
S3_SECRET_KEY=replace-with-your-secret-key
S3_BUCKET=doc-images
S3_PUBLIC_URL=http://localhost:9000/doc-images
